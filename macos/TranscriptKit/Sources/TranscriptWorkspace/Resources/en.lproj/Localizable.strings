/* Tab context menu item, and the close button's accessibility label. */
"Close Tab" = "Close Tab";

/* Tab context menu item: closes every tab but the one clicked. */
"Close Other Tabs" = "Close Other Tabs";

/* Tab context menu item, and the accessibility label of the temporary tab's hollow pin. */
"Pin Tab" = "Pin Tab";

/* Tab context menu item, and the accessibility label of a pinned tab's filled pin. */
"Unpin Tab" = "Unpin Tab";

/* Tab context menu item when there is one editor: opens a second editor on the right with this tab in it. */
"Move to New Editor on Right" = "Move to New Editor on Right";

/* Tab context menu item in the left of two editors. */
"Move to Editor on Right" = "Move to Editor on Right";

/* Tab context menu item in the right of two editors. */
"Move to Editor on Left" = "Move to Editor on Left";

/* Shown in an editor that has no tabs. */
"No Editor" = "No Editor";
