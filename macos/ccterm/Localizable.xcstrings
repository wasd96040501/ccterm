    "Claude Code reads its account when it starts. ccterm ends this session’s process and resumes the conversation as %@, on %@.": {
      "comment": "The restart sheet's text; the account's name and the model's.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code 在启动时读取其账户。ccterm 会结束此会话的进程，并以 %@ 的身份、使用 %@ 继续这段对话。"
          }
        }
      }
    },
