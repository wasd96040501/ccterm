{
  "sourceLanguage": "en",
  "strings": {
    "": {},
    "%@ Copy": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 副本"
          }
        }
      }
    },
    "%@ doesn’t take an effort level": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不支持思考强度"
          }
        }
      }
    },
    "%@ from the first of %lld": {
      "comment": "A paste into the account sheet held several providers; the sheet took the first.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（取自 %2$lld 个中的第一个）"
