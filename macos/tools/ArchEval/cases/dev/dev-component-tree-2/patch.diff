+    /// A gear at the trailing edge, as Xcode's: Settings without the menu.
+    private func settingsItem() -> NSToolbarItem {
+        let title = String(localized: "Settings")
+        let item = NSToolbarItem(itemIdentifier: .settings)
+        item.image = NSImage(systemSymbolName: "gearshape", accessibilityDescription: title)
+        item.label = title
+        item.toolTip = title
+        item.target = self
+        item.action = #selector(showSettings(_:))
+        return item
+    }
+
+    @objc private func showSettings(_ sender: Any?) {
+        let controller =
+            settingsWindowController
+            ?? {
+                let c = SettingsWindowController(
+                    panes: SettingsPane.allCases.map { .init($0, context: settings) },
+                    initial: SettingsPane.general.rawValue)
+                c.windowFrameAutosaveName = "SettingsWindow"
+                settingsWindowController = c
+                return c
+            }()
+        controller.showWindow(nil)
+        controller.window?.makeKeyAndOrderFront(nil)
+    }
