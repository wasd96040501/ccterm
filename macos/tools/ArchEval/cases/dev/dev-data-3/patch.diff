+    private func publishActivity(of state: SessionState, at url: URL) {
+        guard var activity = state.activity else { return }
+        if activity == .needsInput, requestsInView.contains(url) { activity = .responding }
+        if activities[url] != activity { activities[url] = activity }
+    }
+
